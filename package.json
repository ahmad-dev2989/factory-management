{
  "name": "factory-app",
  "private": true,
  "version": "0.0.2",
  "author": "Factory App",
  "description": "Factory App",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "tsc -b && vite build && electron-builder",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "electron-rebuild"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sqlite3": "^3.1.11",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.factory.management",
    "productName": "Factory App",
    "generateUpdatesFilesForAllChannels": true,
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": "**/node_modules/sqlite3/**/*",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/app-icons/icon.ico",
      "artifactName": "Factory-App-Setup-${version}.${ext}"
    },
    "nsis": {
      "packElevateHelper": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Factory App",
      "installerIcon": "public/app-icons/icon.ico",
      "uninstallerIcon": "public/app-icons/icon.ico",
      "uninstallDisplayName": "Factory App",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Factory-App-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "ahmad-dev2989",
      "repo": "factory-management"
    }
  }
}